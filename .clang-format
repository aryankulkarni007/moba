# Derived from the style already present in the fx headers, so that adopting
# this file does not reformat existing code. Where you disagree, change it
# here rather than sprinkling more `// clang-format off`.
---
Language:        Cpp
BasedOnStyle:    LLVM

ColumnLimit:     100
IndentWidth:     2
TabWidth:        2
UseTab:          Never

# `fx{ r }` rather than `fx{r}` -- matches the existing headers.
Cpp11BracedListStyle: false

# Single-line accessors and forwarding operators stay on one line; the fx
# headers are almost entirely made of these. `Inline` means only functions
# defined inside a class body -- free functions keep whatever bracing you gave
# them, which is what you want for things like the _fx literal.
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortCaseLabelsOnASingleLine: true

BreakBeforeBraces: Attach
PointerAlignment: Left
ReferenceAlignment: Left

# Project headers before system headers, and moba/ grouped together.
SortIncludes:    CaseSensitive
IncludeBlocks:   Preserve

SpaceAfterTemplateKeyword: false
AlwaysBreakTemplateDeclarations: Yes
